NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://health_os:health_os@localhost:5432/health_os

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Ollama (AI Coach)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Photo food recognition (optional).
# Without this, scanning a plate photo returns a clear "not configured"
# message and search/barcode logging still work normally.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-5-20250929

# CORS
CORS_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of the app. Defaults to 1 in
# production and 0 in development, so this rarely needs setting.
#
# Behind a platform proxy (Render, Heroku, Fly, a load balancer) every request
# arrives from the proxy's address. At 0, the rate limiter therefore sees a
# single client and its per-IP budget becomes a global one — a handful of
# failed sign-ins from anyone would lock out every user at once.
#
# It is a hop count rather than a boolean on purpose: trusting all proxies lets
# a client set its own X-Forwarded-For and walk past the limit entirely.
TRUST_PROXY_HOPS=1
